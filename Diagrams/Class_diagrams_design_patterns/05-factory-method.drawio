        <mxCell id="note1" value="registerUser() works only with the User abstraction; createUser() is the factory method each concrete creator overrides. A new role means a new creator + product class — no switch statement (OCP). Used by the Identity/Account Service for administrator account management." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=#B09500;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
