        <mxCell id="note1" value="Command (04-A): the change is an object — created by Faculty, held Pending by the «invoker» CourseChangeRequest, executed on Course (receiver) only after Administrator approval; undo() enables reversal and stored commands form the audit log." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=#B09500;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
